{
  "entities": {
    "Calculation": {
      "title": "Calculation History",
      "description": "Records of previous calculations",
      "type": "object",
      "properties": {
        "expression": { "type": "string" },
        "result": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["normal", "scientific", "gst", "emi"] },
        "userId": { "type": "string" }
      },
      "required": ["expression", "result", "timestamp", "userId"]
    },
    "Expense": {
      "title": "Expense Record",
      "description": "Income or expense tracking entry",
      "type": "object",
      "properties": {
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "date": { "type": "string", "format": "date-time" },
        "note": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["amount", "category", "type", "date", "userId"]
    },
    "CashRecord": {
      "title": "Cash Counting Record",
      "description": "Saved cash counting session",
      "type": "object",
      "properties": {
        "notes": { "type": "object" },
        "total": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      },
      "required": ["notes", "total", "date", "userId"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Generated business invoice",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "shopName": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      },
      "required": ["customerName", "items", "total", "date", "userId"]
    }
  },
  "firestore": {
    "/calculations/{calcId}": {
      "schema": "Calculation",
      "description": "Calculation history entries"
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Expense tracker entries"
    },
    "/cash_records/{recordId}": {
      "schema": "CashRecord",
      "description": "Cash counting sessions"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Saved invoices"
    }
  }
}
